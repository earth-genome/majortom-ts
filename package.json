{
  "name": "majortom-eg",
  "version": "1.0.0",
  "description": "TypeScript implementation of the ESA Major TOM equal-area grid system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "geospatial",
    "grid",
    "major-tom",
    "geohash",
    "esa"
  ],
  "author": "Earth Genome <info@earthgenome.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earth-genome/majortom-ts.git"
  },
  "bugs": {
    "url": "https://github.com/earth-genome/majortom-ts/issues"
  },
  "homepage": "https://github.com/earth-genome/majortom-ts#readme",
  "dependencies": {
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/buffer": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "ngeohash": "^0.6.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
